{
  "name": "cinema-app-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.20.0",
    "styled-components": "^6.1.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.14.7",
    "@faker-js/faker": "^10.1.0",
    "@vitejs/plugin-react": "^4.2.0",
    "cypress": "^15.5.0",
    "nyc": "^17.1.0",
    "rimraf": "^6.0.1",
    "start-server-and-test": "^2.1.2",
    "vite": "^5.0.0"
  },
  "scripts": {
    "start": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "preview": "vite preview --config vite.config.mjs",
    "clean": "rimraf dist node_modules/.vite",
    "dev": "vite --config vite.config.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "test:e2e": "cypress run",
    "test:e2e:headed": "cypress run --headed",
    "test:e2e:auth": "cypress run --spec 'cypress/e2e/auth.cy.js'",
    "test:e2e:movies": "cypress run --spec 'cypress/e2e/movies.cy.js'",
    "test:e2e:errors": "cypress run --spec 'cypress/e2e/error-handling.cy.js'",
    "test:e2e:ci": "start-server-and-test dev http://localhost:5173 cypress:run"
  },
  "type": "module",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
